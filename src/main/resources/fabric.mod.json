{
	"schemaVersion": 1,
	"id": "frameposer",
	"version": "${version}",
	"name": "Item Frame Poser",
	"description": "Look at an item frame and press a keybind to pose the item with rotation, offset, and scale.",
	"authors": [
		"BLOODWOLF"
	],
	"contact": {
		"homepage": "https://github.com/BLOODWOOF/itemframe-poser",
		"sources": "https://github.com/BLOODWOOF/itemframe-poser",
		"issues": "https://github.com/BLOODWOOF/itemframe-poser/issues"
	},
	"license": "MIT",
	"icon": "assets/frameposer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"frameposer.FramePoser"
		],
		"client": [
			"frameposer.FramePoserClient"
		]
	},
	"mixins": [
		"frameposer.mixins.json",
		{
			"config": "frameposer.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"fastitemframes": "*"
	}
}
